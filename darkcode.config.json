{
  "profile": "local",
  "server": {
    "host": "127.0.0.1",
    "port": 8787,
    "cors": [
      "https://jake12733.github.io",
      "http://localhost:*",
      "http://127.0.0.1:*"
    ],
    "token": "${DC_TOKEN}"
  },
  "pools": {
    "gpu0": {
      "concurrency": 1,
      "exclusive": true
    },
    "server": {
      "concurrency": 16,
      "exclusive": false
    }
  },
  "engines": {
    "ollama": {
      "type": "ollama",
      "enabled": true,
      "baseUrl": "http://127.0.0.1:11434",
      "pool": "gpu0",
      "keepAlive": "0"
    },
    "lmstudio": {
      "type": "openai",
      "enabled": false,
      "baseUrl": "http://127.0.0.1:1234/v1",
      "pool": "gpu0",
      "launch": {
        "cmd": "lms",
        "args": [
          "server",
          "start"
        ],
        "readyTimeoutSec": 60,
        "idleStopSec": 0
      }
    },
    "llamacpp": {
      "type": "openai",
      "enabled": false,
      "baseUrl": "http://127.0.0.1:8080/v1",
      "pool": "gpu0",
      "launch": {
        "cmd": "llama-server",
        "args": [
          "-m",
          "models/qwen3-8b-q4_k_m.gguf",
          "--port",
          "8080",
          "-c",
          "16384",
          "-ngl",
          "99",
          "--jinja"
        ],
        "readyTimeoutSec": 180,
        "idleStopSec": 300
      }
    },
    "localai": {
      "type": "openai",
      "enabled": false,
      "baseUrl": "http://127.0.0.1:8081/v1",
      "pool": "gpu0"
    },
    "vllm": {
      "type": "openai",
      "enabled": false,
      "baseUrl": "${VLLM_URL}",
      "apiKey": "${VLLM_API_KEY}",
      "pool": "server",
      "reasoning": true
    },
    "sglang": {
      "type": "openai",
      "enabled": false,
      "baseUrl": "${SGLANG_URL}",
      "apiKey": "${SGLANG_API_KEY}",
      "pool": "server",
      "reasoning": true
    },
    "acestep": {
      "type": "acestep",
      "enabled": true,
      "baseUrl": "http://127.0.0.1:8001",
      "pool": "gpu0",
      "launch": {
        "cmd": "uv",
        "args": [
          "run",
          "acestep-api"
        ],
        "cwd": "${ACESTEP_DIR}",
        "env": {
          "ACESTEP_API_PORT": "8001",
          "ACESTEP_LM_BACKEND": "pt",
          "ACESTEP_LM_MODEL_PATH": "acestep-5Hz-lm-0.6B",
          "ACESTEP_OFFLOAD_TO_CPU": "true"
        },
        "readyTimeoutSec": 1200,
        "idleStopSec": 600
      }
    }
  },
  "roles": {
    "router": [
      {
        "engine": "ollama",
        "model": "qwen3:8b",
        "system": "prompts/router.md",
        "params": {
          "temperature": 0,
          "max_tokens": 120,
          "think": false
        }
      }
    ],
    "strategist": [
      {
        "engine": "vllm",
        "model": "qwen3-32b",
        "profiles": [
          "server",
          "hybrid"
        ],
        "system": "prompts/strategist.md",
        "params": {
          "temperature": 0.4,
          "max_tokens": 900
        }
      },
      {
        "engine": "ollama",
        "model": "qwen3:8b",
        "system": "prompts/strategist.md",
        "params": {
          "temperature": 0.4,
          "max_tokens": 900,
          "think": false
        }
      }
    ],
    "implementer.code": [
      {
        "engine": "vllm",
        "model": "qwen3-32b",
        "profiles": [
          "server",
          "hybrid"
        ],
        "system": "prompts/core.md",
        "params": {
          "temperature": 0.3,
          "max_tokens": 16384
        }
      },
      {
        "engine": "llamacpp",
        "model": "qwen3-8b",
        "system": "prompts/core.md",
        "params": {
          "temperature": 0.3,
          "max_tokens": 8192
        }
      },
      {
        "engine": "ollama",
        "model": "ai-dev",
        "params": {
          "max_tokens": 8192,
          "think": true
        }
      }
    ],
    "implementer.web": [
      {
        "engine": "vllm",
        "model": "qwen3-32b",
        "profiles": [
          "server",
          "hybrid"
        ],
        "system": "prompts/web.md",
        "params": {
          "temperature": 0.5,
          "max_tokens": 16384
        }
      },
      {
        "engine": "ollama",
        "model": "ai-dev",
        "params": {
          "max_tokens": 8192,
          "think": true
        }
      }
    ],
    "implementer.security": [
      {
        "engine": "sglang",
        "model": "qwen3-32b",
        "profiles": [
          "server",
          "hybrid"
        ],
        "system": "prompts/security.md",
        "params": {
          "temperature": 0.2,
          "max_tokens": 8192
        }
      },
      {
        "engine": "ollama",
        "model": "qwen3:8b",
        "system": "prompts/security.md",
        "params": {
          "temperature": 0.2,
          "max_tokens": 4096,
          "think": false
        }
      }
    ],
    "implementer.prompt": [
      {
        "engine": "ollama",
        "model": "ai-media",
        "params": {
          "max_tokens": 3072,
          "think": false
        }
      }
    ],
    "implementer.general": [
      {
        "engine": "ollama",
        "model": "ai-qa",
        "params": {
          "max_tokens": 2048,
          "think": false
        }
      }
    ],
    "critic": [
      {
        "engine": "ollama",
        "model": "ai-critic",
        "params": {
          "temperature": 0.1,
          "max_tokens": 600,
          "think": false
        }
      }
    ],
    "escalate": [
      {
        "engine": "vllm",
        "model": "qwen3-32b",
        "profiles": [
          "server",
          "hybrid"
        ],
        "system": "prompts/core.md",
        "params": {
          "temperature": 0.3,
          "max_tokens": 16384
        }
      }
    ],
    "composer": [
      {
        "engine": "ollama",
        "model": "qwen3:8b",
        "system": "prompts/composer.md",
        "params": {
          "temperature": 0.8,
          "max_tokens": 1500,
          "think": false
        }
      }
    ],
    "storyboard": [
      {
        "engine": "ollama",
        "model": "qwen3:8b",
        "system": "prompts/storyboard.md",
        "params": {
          "temperature": 0.7,
          "max_tokens": 1500,
          "think": false
        }
      }
    ]
  },
