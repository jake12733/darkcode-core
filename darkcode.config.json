  "pipelines": {
    "fast": [
      "cache",
      "context",
      "route",
      "implementer",
      "verify",
      "render"
    ],
    "full": [
      "cache",
      "context",
      "route",
      "strategist",
      "implementer",
      "critic",
      "gate",
      "render"
    ]
  },
  "limits": {
    "maxRevisions": 2,
    "contextTokens": 6000,
    "keepRecentMessages": 4,
    "cacheTtlSec": 86400,
    "routerMinScore": 2,
    "requestTimeoutSec": 900,
    "maxBodyBytes": 2000000
  },
  "storage": {
    "path": "data/darkcode.db"
  }
