# darkcode-core 환경변수 (이 파일을 .env 로 복사해서 사용, .env 는 git 에 올리지 않음)

# 실행 프로필: local | hybrid | server
DC_PROFILE=local

# 게이트웨이 접근 토큰 (서버/외부 공개 시 필수, 로컬 단독이면 비워도 됨)
DC_TOKEN=

# 서버 엔진 (Phase 3) — 비워 두면 해당 엔진은 자동 비활성
VLLM_URL=
VLLM_API_KEY=
SGLANG_URL=
SGLANG_API_KEY=

# 디버그 로그
# DC_DEBUG=1

# 음악 엔진 ACE-Step 1.5 설치 폴더 (setup-acestep.bat 가 자동으로 채움). 비워 두면 자동 기동 없이 http://127.0.0.1:8001 에 이미 떠 있는 서버만 사용
ACESTEP_DIR=
